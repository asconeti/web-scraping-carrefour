
from selenium.webdriver.support.ui import WebDriverWait
from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.chrome.options import Options
from bs4 import BeautifulSoup
import requests
import time
# URL de la primera página

base_url = "https://www.carrefour.es/supermercado/bebe/cat20006/c?offset="

# Parámetros iniciales
offset = 1
products_found = True

def inicialitzar_driver():
    """
    Inicialitza un nou driver de Selenium amb configuració predefinida.
    """
    options = Options()
    options.add_argument("--headless")
    options.add_argument("--no-sandbox")
    options.add_argument("--disable-dev-shm-usage")
    options.add_argument("user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36")
    service = Service("/usr/bin/chromedriver")
    driver = webdriver.Chrome(service=service, options=options)
    return driver

while products_found:
    url = f"{base_url}{offset*24}"
    driver = inicialitzar_driver()
    driver.get(url)
    time.sleep(5)  # Espera inicial abans d'interactuar amb la pàgina

    # Espera que la pàgina es carregui completament
    wait = WebDriverWait(driver, 20)
    response = requests.get(url)
    soup = BeautifulSoup(driver.page_source, "html.parser")

    target_li = soup.select("li.product-card-list__item")

    # Buscar productos en la página
    if target_li:
        print(f"Página {offset} encontrada, con url: {url} y {len(target_li)} productos.")
        offset += 1  # Ir a la siguiente página
    else:
        print(f"Última página {offset} no encontrada.")
        products_found = False